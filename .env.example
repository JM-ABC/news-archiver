# ── 필수 ──────────────────────────────────────────────
# Anthropic Claude API 키 (https://console.anthropic.com/)
CLAUDE_API_KEY=your-claude-api-key-here

# ── Notion (선택 — 둘 중 하나만 설정해도 됨) ──────────
# Notion Integration 토큰 (https://www.notion.so/my-integrations)
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxx

# [방법 A] Database ID — Notion DB URL에서 복사 (권장)
#   예) https://notion.so/workspace/abc123def456... → abc123def456...
NOTION_DATABASE_ID=

# [방법 B] 단일 페이지 ID — 기존 페이지에 날짜별로 추가
#   예) https://notion.so/workspace/페이지제목-abc123... → abc123...
NOTION_PAGE_ID=

# ── 이메일 (선택) ──────────────────────────────────────
# Resend API 키 (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# 발신자 이메일 (Resend에서 인증된 도메인 주소)
EMAIL_FROM=newsletter@yourdomain.com

# 주 수신자 (쉼표 구분, 다수 가능)
EMAIL_TO=you@example.com

# BCC 수신자 (쉼표 구분, 다수 가능 — 생략 가능)
EMAIL_BCC=

# ── 선택 ──────────────────────────────────────────────
# 트렌드 파일 저장 경로 (기본값: ./trends)
TRENDS_DIR=./trends

# 수신거부 링크 URL (설정 시 푸터에 표시 — 생략 가능)
EMAIL_UNSUBSCRIBE_URL=

# ── 카톡 자동 발송 (선택, Windows 로컬 전용) ────────────
# 발송 대상 오픈채팅방 이름 (카카오톡 PC 앱 채팅방 창 제목과 정확히 일치해야 함)
KAKAO_CHATROOM_NAME=

# 발송 승인 팝업 대기 시간(분) — 이 시간 안에 확인하지 않으면 자동 취소 (기본값: 30)
KAKAO_APPROVAL_TIMEOUT_MIN=30
